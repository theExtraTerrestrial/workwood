{
  "name": "workwood",
  "version": "0.1.0",
  "private": true,
  "description": "Run and oversee several Claude Code sessions at once, grouped by Claudius profile.",
  "type": "module",
  "main": "shell/main.cjs",
  "scripts": {
    "postinstall": "install-electron && node -e \"for (const a of ['arm64','x64']) { try { require('fs').chmodSync('node_modules/node-pty/prebuilds/darwin-'+a+'/spawn-helper', 0o755) } catch {} }\"",
    "start": "electron .",
    "edge": "node shell/edge.mjs",
    "install-app": "node shell/install-app.mjs",
    "shortcut": "node shell/windows-shortcut.mjs",
    "service": "node service/server.mjs",
    "pretest": "node -e \"fs.rmSync(path.join(os.tmpdir(), 'workwood-test-failures'), { recursive: true, force: true })\"",
    "test": "node --test tests/app.test.mjs tests/phone.test.mjs tests/copy.test.mjs",
    "test:stress": "node tests/stress.mjs",
    "package": "node shell/windows-package.mjs",
    "site": "node site/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.323",
    "@huggingface/transformers": "^4.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "phonemizer": "^1.2.1"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "playwright-core": "^1.65.0"
  }
}
